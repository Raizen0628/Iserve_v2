<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="7dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/designbrg_v2"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: avatar, name/email, status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="#FFEBEE"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#F44336"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtBorrowerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/onSurface"
                    android:textStyle="bold"
                    tools:text="Juan Dela Cruz" />

                <TextView
                    android:id="@+id/txtBorrowerEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/onSurfaceVariant"
                    tools:text="resident@iserveko.com" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="PENDING"
                android:textColor="#49454F"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Details panel -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#F7F7F7"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Items Requested"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/onSurfaceVariant" />

                    <TextView
                        android:id="@+id/txtRequestedQuantities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/dash_teal"
                        android:textStyle="bold"
                        tools:text="🪑 2 Tables | 🪑 15 Chairs" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="12dp"
                    android:background="#14000000" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date Needed"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/onSurfaceVariant" />

                    <TextView
                        android:id="@+id/txtBorrowDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/onSurface"
                        android:textStyle="bold"
                        tools:text="Oct 15, 2026" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Purpose -->
        <TextView
            android:id="@+id/txtPurpose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/onSurface"
            tools:text="Purpose: Barangay Birthday Event" />

        <!-- Remarks -->
        <TextView
            android:id="@+id/txtRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pinned_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/dash_orange"
            android:visibility="gone"
            tools:text="Remarks: Approved by Barangay Official"
            tools:visibility="visible" />

        <!-- Official actions -->
        <LinearLayout
            android:id="@+id/layoutOfficialActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDecline"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Decline"
                android:textColor="@color/dash_red"
                android:textSize="13sp"
                app:cornerRadius="22dp"
                app:strokeColor="@color/dash_red" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprove"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/dash_teal"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Approve"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:cornerRadius="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkReturned"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/dash_blue"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Mark Returned"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="22dp" />
        </LinearLayout>

        <!-- Resident actions -->
        <LinearLayout
            android:id="@+id/layoutResidentActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelRequest"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cancel Request"
                android:textColor="@color/dash_red"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="22dp"
                app:strokeColor="@color/dash_red" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResidentReturn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="@color/dash_blue"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Return Equipment"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="22dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>